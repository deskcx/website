# Copy to .env.local and fill in. Next.js only exposes NEXT_PUBLIC_-prefixed
# variables to the browser.
#
# These are needed only by /auth/callback, which completes password resets and
# invitations. GoTrue returns the session in the URL fragment, so that exchange
# has to happen in the browser.
#
# Both values are INLINED INTO THE BUNDLE at build time and are public by
# design — the key identifies the project, it does not authenticate anyone.
# What protects data is Row-Level Security plus the signed-in user's JWT. Never
# put the secret key (`sb_secret_…`, formerly SERVICE_ROLE_KEY) here; it
# bypasses RLS entirely.

# The Supabase Cloud project endpoint (project ref `tlphhqwxfvvdvevtpqlo`,
# region eu-central-2 / Zurich). As of 2026-09-08 this replaces
# `https://api.taxassistants.org`, the Cloudflare Tunnel to the self-hosted
# stack — see .claude/tech-specs/networking.md.
NEXT_PUBLIC_SUPABASE_URL=https://tlphhqwxfvvdvevtpqlo.supabase.co

# Dashboard -> Settings -> API Keys -> "Publishable and secret API keys", or
# from the supabase repo: `grep '^SUPABASE_PUBLISHABLE_KEY=' .env.cloud`.
# An `sb_publishable_…` value, not the old `eyJ…` anon JWT; supabase-js accepts
# it in this slot unchanged.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
